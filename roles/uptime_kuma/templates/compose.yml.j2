---
services:
  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: uptime-kuma
    restart: unless-stopped
    ports:
      - "{{ uptime_kuma_port }}:3001/tcp"
    volumes:
      - "{{ uptime_kuma_dir }}/data:/app/data"
    networks:
      - dns

networks:
  dns:
    external: true
    name: homelab-dns
