---
services:
  beszel-agent:
    image: {{ beszel_agent_image }}
    container_name: beszel-agent
    restart: unless-stopped
    network_mode: host
    volumes:
      - "{{ beszel_agent_data_dir }}:/var/lib/beszel-agent"
{% if beszel_agent_docker_socket | bool %}
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% endif %}
    environment:
      LISTEN: "{{ beszel_agent_port }}"
      HUB_URL: {{ beszel_hub_url | quote }}
      SYSTEM_NAME: {{ inventory_hostname | quote }}
      KEY: {{ beszel_agent_key | quote }}
      TOKEN: {{ beszel_agent_token | quote }}
